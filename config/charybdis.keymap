#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };

        ctrl_alt_del: ctrl_alt_del {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(DELETE))>;
            label = "CTRL_ALT_DEL";
        };

        ctrl_alt_esc: ctrl_alt_esc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(ESCAPE))>;
            label = "CTRL_ALT_ESC";
        };
    };

    behaviors {
        td_square_bracket: td_square_bracket {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SQUARE_BRACKET";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        };

        mto: mto {
            compatible = "zmk,behavior-hold-tap";
            label = "Mod/Toggle";
            bindings = <&tog>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        td_esc_pscrn: td_esc_pscrn {
            compatible = "zmk,behavior-tap-dance";
            label = "Tap dance esc & printscreen";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE>, <&kp PRINTSCREEN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&td_esc_pscrn       &kp N1          &kp N2          &kp N3                &kp N4                &kp N5                    &kp N6                   &kp N7                 &kp N8                    &kp N9           &kp N0              &td_square_bracket
&kp TAB             &kp Q           &kp W           &kp E                 &kp R                 &kp T                     &kp Y                    &kp U                  &kp I                     &kp O            &kp P               &kp BSLH
&mt CAPSLOCK GRAVE  &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_SHIFT D      &mt LEFT_CONTROL F    &lt 1 G                   &lt 1 H                  &mt RIGHT_CONTROL J    &mt RIGHT_SHIFT K         &mt RIGHT_ALT L  &mt RIGHT_GUI SEMI  &mto 4 SQT
&kp MINUS           &kp Z           &kp X           &mt K_CONTEXT_MENU C  &lt 3 V               &lt 2 B                   &lt 2 N                  &lt 3 M                &mt K_CONTEXT_MENU COMMA  &kp DOT          &kp FSLH            &mto 5 EQUAL
                                                    &mto 4 LEFT_ALT       &mt LEFT_SHIFT SPACE  &kp DEL                   &kp BACKSPACE            &mt RIGHT_SHIFT SPACE
                                                                          &mto 5 LEFT_WIN       &mt LEFT_CONTROL ENTER    &mt RIGHT_CONTROL ENTER
            >;
        };

        Fn_Layer {
            bindings = <
&kp F1  &kp F2            &kp F3          &kp F4        &kp F5  &kp F6    &kp F7  &kp F8  &kp F9    &kp F10       &kp F11    &kp F12
&trans  &kp C_PLAY_PAUSE  &kp C_PREVIOUS  &kp C_NEXT    &none   &trans    &none   &none   &none     &kp UP_ARROW  &kp MINUS  &kp EQUAL
&trans  &kp K_MUTE        &kp C_VOL_DN    &kp C_VOL_UP  &none   &trans    &trans  &none   &kp LEFT  &kp DOWN      &kp RIGHT  &trans
&trans  &trans            &trans          &trans        &trans  &trans    &trans  &trans  &trans    &trans        &none      &trans
                                          &trans        &trans  &none     &none   &none
                                                        &trans  &trans    &trans
            >;
        };

        BT_layer {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_PRV      &bt BT_NXT    &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR      &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans  &trans
                                                    &trans        &trans          &trans
            >;
        };

        Scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        Mouse_layer {
            bindings = <
&none  &none  &none  &none   &none   &none    &none      &none           &none      &none  &none  &none
&none  &none  &none  &none   &none   &none    &none      &msc SCRL_UP    &none      &none  &none  &none
&none  &none  &none  &none   &none   &none    &mkp LCLK  &mkp MCLK       &mkp RCLK  &none  &none  &tog 4
&none  &none  &none  &none   &none   &none    &none      &msc SCRL_DOWN  &none      &none  &none  &tog 5
                     &tog 4  &none   &none    &mkp LCLK  &mkp RCLK
                             &tog 5  &none    &none
            >;
        };

        Snipe_layer {
            bindings = <
&none  &none  &none  &none   &none   &none    &none      &none           &none      &none  &none  &none
&none  &none  &none  &none   &none   &none    &none      &msc SCRL_UP    &none      &none  &none  &none
&none  &none  &none  &none   &none   &none    &mkp LCLK  &mkp MCLK       &mkp RCLK  &none  &none  &tog 4
&none  &none  &none  &none   &none   &none    &none      &msc SCRL_DOWN  &none      &none  &none  &tog 5
                     &tog 4  &none   &none    &mkp LCLK  &mkp RCLK
                             &tog 5  &none    &none
            >;
        };
    };
};
