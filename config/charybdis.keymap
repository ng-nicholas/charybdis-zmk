#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt { flavor = "tap-preferred"; };

&mt { flavor = "tap-preferred"; };

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };

        ctrl_alt_del: ctrl_alt_del {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(DELETE))>;
            label = "CTRL_ALT_DEL";
        };

        ctrl_alt_esc: ctrl_alt_esc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(ESCAPE))>;
            label = "CTRL_ALT_ESC";
        };
    };

    behaviors {
        td_square_bracket: td_square_bracket {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SQUARE_BRACKET";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        };

        mto: mto {
            compatible = "zmk,behavior-hold-tap";
            label = "Mod/Toggle";
            bindings = <&tog>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        td_esc_pscrn: td_esc_pscrn {
            compatible = "zmk,behavior-tap-dance";
            label = "Tap dance esc & printscreen";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE>, <&kp PRINTSCREEN>;
        };

        td_f4_altf4: td_f4_altf4 {
            compatible = "zmk,behavior-tap-dance";
            label = "Tap dance F4 and Alt+F4";
            #binding-cells = <0>;
            bindings = <&kp F4>, <&kp LA(F4)>;
        };

        td_space_enter: td_space_enter {
            compatible = "zmk,behavior-tap-dance";
            label = "tap space double enter";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&kp ENTER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&td_esc_pscrn       &kp N1          &kp N2          &kp N3            &kp N4              &kp N5                      &kp N6                     &kp N7               &kp N8             &kp N9           &kp N0              &td_square_bracket
&kp TAB             &kp Q           &kp W           &kp E             &kp R               &kp T                       &kp Y                      &kp U                &kp I              &kp O            &kp P               &kp BSLH
&mt CAPSLOCK GRAVE  &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LEFT_CONTROL F  &mt K_CONTEXT_MENU G        &mt K_CONTEXT_MENU H       &mt RIGHT_CONTROL J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &mt RIGHT_GUI SEMI  &kp SQT
&lt 5 MINUS         &lt 4 Z         &lt 3 X         &lt 2 C           &lt 1 V             &kp B                       &kp N                      &lt 1 M              &lt 2 COMMA        &lt 3 DOT        &lt 4 FSLH          &lt 5 EQUAL
                                                    &lt 4 HOME        &td_space_enter     &kp DEL                     &kp BACKSPACE              &td_space_enter
                                                                      &lt 5 END           &mt UP_ARROW RIGHT_ARROW    &mt DOWN_ARROW LEFT_ARROW
            >;
        };

        Fn_Layer {
            bindings = <
&kp F1  &kp F2  &kp F3  &td_f4_altf4  &kp F5  &kp F6    &kp F7  &kp F8          &kp F9          &kp F10          &kp F11   &kp F12
&trans  &trans  &trans  &trans        &trans  &trans    &trans  &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &kp HOME  &trans
&trans  &trans  &trans  &trans        &trans  &trans    &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END   &trans
&trans  &trans  &trans  &trans        &trans  &trans    &trans  &trans          &trans          &trans           &trans    &trans
                        &trans        &trans  &trans    &trans  &trans
                                      &trans  &trans    &trans
            >;
        };

        BT_layer {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4    &trans  &kp K_MUTE        &kp C_VOL_DN  &kp C_VOL_UP  &trans  &trans
&trans  &bt BT_PRV      &bt BT_NXT    &bt BT_CLR    &bt BT_CLR_ALL  &trans          &trans  &kp C_PLAY_PAUSE  &kp C_PREV    &kp C_NEXT    &trans  &trans
&trans  &studio_unlock  &trans        &trans        &trans          &trans          &trans  &trans            &trans        &trans        &trans  &trans
&trans  &trans          &trans        &trans        &trans          &trans          &trans  &trans            &trans        &trans        &trans  &trans
                                      &trans        &trans          &trans          &trans  &trans
                                                    &trans          &trans          &trans
            >;
        };

        Scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        Mouse_layer {
            bindings = <
&none   &none   &none      &none           &none      &none    &none  &none      &none           &none      &none   &none
&none   &none   &none      &msc SCRL_UP    &none      &none    &none  &none      &msc SCRL_UP    &none      &none   &none
&none   &none   &mkp RCLK  &mkp MCLK       &mkp LCLK  &none    &none  &mkp LCLK  &mkp MCLK       &mkp RCLK  &none   &none
&trans  &trans  &none      &msc SCRL_DOWN  &none      &none    &none  &none      &msc SCRL_DOWN  &none      &trans  &trans
                           &trans          &none      &none    &none  &none
                                           &trans     &none    &none
            >;
        };

        Snipe_layer {
            bindings = <
&none   &none   &none      &none           &none      &none    &none  &none      &none           &none      &none   &none
&none   &none   &none      &msc SCRL_UP    &none      &none    &none  &none      &msc SCRL_UP    &none      &none   &none
&none   &none   &mkp RCLK  &mkp MCLK       &mkp LCLK  &none    &none  &mkp LCLK  &mkp MCLK       &mkp RCLK  &none   &none
&trans  &trans  &none      &msc SCRL_DOWN  &none      &none    &none  &none      &msc SCRL_DOWN  &none      &trans  &trans
                           &trans          &none      &none    &none  &none
                                           &trans     &none    &none
            >;
        };
    };
};
